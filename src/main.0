    var input: [8192]u8 = [0_u8; 8192]
    var model: [256]u8 = [0_u8; 256]
    var key: [2048]u8 = [0_u8; 2048]
    var endpoint: [2048]u8 = [0_u8; 2048]
    var workspace: [4096]u8 = [0_u8; 4096]
    var executable: [4096]u8 = [0_u8; 4096]
    var arguments: [16384]u8 = [0_u8; 16384]
    var toolId: [256]u8 = [0_u8; 256]
    var toolName: [128]u8 = [0_u8; 128]
    var result: [16400]u8 = [0_u8; 16400]
    var errors: [8192]u8 = [0_u8; 8192]
    var keyboard: [8192]u8 = [0_u8; 8192]
    var frame: [49152]u8 = [0_u8; 49152]
    var historyEmpty: [32]u8 = [0_u8; 32]
    var transcriptEmpty: [32]u8 = [0_u8; 32]
    var pendingEmpty: [32]u8 = [0_u8; 32]
    var packetEmpty: [32]u8 = [0_u8; 32]
    var responseEmpty: [32]u8 = [0_u8; 32]
    var scratchEmpty: [32]u8 = [0_u8; 32]
    var snapshotEmpty: [32]u8 = [0_u8; 32]
    var mcpConfigEmpty: [32]u8 = [0_u8; 32]
    var mcpToolsEmpty: [32]u8 = [0_u8; 32]
    var mcpTxEmpty: [32]u8 = [0_u8; 32]
    var mcpCursorEmpty: [32]u8 = [0_u8; 32]
    var skillsEmpty: [32]u8 = [0_u8; 32]
    var activeSkillEmpty: [32]u8 = [0_u8; 32]
    var systemContextEmpty: [32]u8 = [0_u8; 32]
    var mcpRx0Empty: [32]u8 = [0_u8; 32]
    var mcpRx1Empty: [32]u8 = [0_u8; 32]
    var mcpRx2Empty: [32]u8 = [0_u8; 32]
    var mcpRx3Empty: [32]u8 = [0_u8; 32]
    var app: App = App { provider: 0, view: 0, selection: 0, phase: 0, alive: true, headless: false, approve: false, demo: false, paste: false, history: buffer(historyEmpty), transcript: buffer(transcriptEmpty), input: buffer(input), model: buffer(model), key: buffer(key), endpoint: buffer(endpoint), workspace: buffer(workspace), executable: buffer(executable), pending: buffer(pendingEmpty), arguments: buffer(arguments), toolId: buffer(toolId), toolName: buffer(toolName), result: buffer(result), packet: buffer(packetEmpty), response: buffer(responseEmpty), errors: buffer(errors), scratch: buffer(scratchEmpty), frame: buffer(frame), keyboard: buffer(keyboard), child: std.proc.spawnChild(""), sent: 0, toolIndex: 0, turn: 0, maxTurns: 20, toolCount: 0, filesChanged: 0, tokens: 0, scroll: 0, turnStart: 0, started: std.time.monotonic(), tick: 0, exitCode: 0, toolsEnabled: true, lastToolSnapshot: buffer(snapshotEmpty), repeatCount: 0, mcpConfig: buffer(mcpConfigEmpty), mcpTools: buffer(mcpToolsEmpty), mcpTx: buffer(mcpTxEmpty), mcpCursor: buffer(mcpCursorEmpty), skills: buffer(skillsEmpty), activeSkill: buffer(activeSkillEmpty), systemContext: buffer(systemContextEmpty), mcpRx0: buffer(mcpRx0Empty), mcpRx1: buffer(mcpRx1Empty), mcpRx2: buffer(mcpRx2Empty), mcpRx3: buffer(mcpRx3Empty), mcpChild0: std.proc.spawnChild(""), mcpChild1: std.proc.spawnChild(""), mcpChild2: std.proc.spawnChild(""), mcpChild3: std.proc.spawnChild(""), mcpCount: 0, mcpIndex: 0, mcpStage: 0, mcpRequest: 0, mcpSent: 0, mcpPage: 0, mcpConnectAll: false, skillCount: 0 }
    return check toolGuardStorage(world, &mut app)
}

fn scratchStorage(world: World, app: mutref<App>) -> i32 raises {
    var scratch: [122880]u8 = [0_u8; 122880]
    app.scratch = buffer(scratch)
    return check extensionStorage0(world, app)
}

fn extensionStorage0(world: World, app: mutref<App>) -> i32 raises {
    var storage: [32784]u8 = [0_u8; 32784]
    app.mcpConfig = buffer(storage)
    return check extensionStorage1(world, app)
}

fn extensionStorage1(world: World, app: mutref<App>) -> i32 raises {
    var storage: [65552]u8 = [0_u8; 65552]
    app.mcpTools = buffer(storage)
    return check extensionStorage2(world, app)
}

fn extensionStorage2(world: World, app: mutref<App>) -> i32 raises {
