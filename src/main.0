fn extensionStorage5(world: World, app: mutref<App>) -> i32 raises {
    var storage: [16400]u8 = [0_u8; 16400]
    app.activeSkill = buffer(storage)
    return check extensionStorage6(world, app)
}

fn extensionStorage6(world: World, app: mutref<App>) -> i32 raises {
    var storage: [65552]u8 = [0_u8; 65552]
    app.systemContext = buffer(storage)
    return check extensionStorage7(world, app)
}

fn extensionStorage7(world: World, app: mutref<App>) -> i32 raises {
    var storage: [65552]u8 = [0_u8; 65552]
    app.mcpRx0 = buffer(storage)
    return check extensionStorage8(world, app)
}

fn extensionStorage8(world: World, app: mutref<App>) -> i32 raises {
    var storage: [65552]u8 = [0_u8; 65552]
    app.mcpRx1 = buffer(storage)
    return check extensionStorage9(world, app)
}

fn extensionStorage9(world: World, app: mutref<App>) -> i32 raises {
    var storage: [65552]u8 = [0_u8; 65552]
    app.mcpRx2 = buffer(storage)
    return check extensionStorage10(world, app)
}

fn extensionStorage10(world: World, app: mutref<App>) -> i32 raises {
    var storage: [65552]u8 = [0_u8; 65552]
    app.mcpRx3 = buffer(storage)
    return check extensionReady(world, app)
}

fn extensionReady(world: World, app: mutref<App>) -> i32 raises {
    setText(app.mcpConfig, "[]")
    setText(app.mcpTools, "[]")
    setText(app.skills, "[]")
    let code: i32 = rescue readyApp(world, app) err 1
    disconnectAllMcp(app)
    return code
}

fn readyApp(world: World, app: mutref<App>) -> i32 raises {
    if !parseOptions(app) {
        check world.out.write(bytes(app.transcript))
        check world.out.write("Invalid options. Run with --help.\n")
        return 1
    }
    let configured: Bool = loadMcpConfig(app)
    reloadSkills(app)
    let skill: Maybe<String> = std.args.valueAfter("--skill")
    if skill.has {
        selectSkill(app, skill.value)
    }
    let connect: Maybe<String> = std.args.valueAfter("--mcp")
    if connect.has && !app.demo && !hasArg("--snapshot") {
        if !configured {
            check world.out.write(bytes(app.transcript))
            return 1
        }
        let headless: Bool = app.headless
        app.headless = true
        beginMcp(app, connect.value)
        check eventLoop(world, app)
        app.headless = headless
        if app.exitCode != 0 {
            check world.out.write(bytes(app.transcript))
            return 1
        }
    }
    if app.demo {
        demoSession(app)
    }
    if hasArg("--snapshot") {
        check render(world, app)
        return 0
    }
    if app.headless {
        let prompt: Maybe<String> = std.args.valueAfter("--prompt")
        if !prompt.has {
            check world.out.write("--prompt requires text.\n")
            return 1
        }
        setText(app.input, prompt.value)
        if !bufOk(app.input) || bufLen(app.input) == 0 {
            check world.out.write("Prompt is empty or exceeds 8 KiB.\n")
            return 1
        }
        if bufLen(app.key) == 0 {
            app.exitCode = 1
        }
        submit(app)
        check eventLoop(world, app)
        check world.out.write(bytes(app.transcript))
        return app.exitCode
    }
    if !std.term.stdinIsTty() || !std.term.stdoutIsTty() {
        check world.out.write("The TUI requires an interactive terminal. Use --prompt TEXT or --demo --snapshot.\n")
        return 1
    }
    let raw: Bool = std.term.enterRawMode()
    if !raw {
        check world.out.write("Could not enter raw terminal mode.\n")
        return 1
    }
    check world.out.write(std.term.enterAltScreen())
    check world.out.write(std.term.enterBracketedPaste())
    check world.out.write(std.term.hideCursor())
    let success: Bool = rescue runInteractive(world, app) err false
    stopChild(app)
    let restored: Bool = std.term.leaveRawMode()
    check world.out.write(std.term.reset())
    check world.out.write(std.term.leaveBracketedPaste())
    check world.out.write(std.term.showCursor())
    check world.out.write(std.term.leaveAltScreen())
    forgetKey(app)
    if !success || !restored {
        return 1
    }
    return 0
}

fn eventLoop(world: World, app: mutref<App>) -> Void raises {
    while app.alive {
        if !app.headless {
            readKeyboard(app)
        }
        if !app.alive {
            break
        }
        pollMcp(app)
        if app.phase == 1 || app.phase == 3 {
            pollProcess(app)
        }
        if app.phase == 2 {
            nextTool(app)
        }
        if app.headless && app.phase == 0 {
            break
        }
        if !app.headless && app.tick % 4 == 0 {
            check render(world, app)
        }
        app.tick = app.tick + 1
        let slept: Bool = std.time.sleep(std.time.ms(20))
    }
}

fn stopChild(app: mutref<App>) -> Void {
    if app.mcpStage > 0 {
        disconnectMcp(app, app.mcpIndex)
        app.mcpStage = 0
        app.mcpConnectAll = false
    }
    if std.proc.childValid(app.child) {
        let pid: i32 = std.proc.pid(app.child)
        if pid > 0 {
            let killed: Bool = std.proc.killGroupPid(pid)
        }
        let closed: Bool = std.proc.close(app.child)
        app.child = std.proc.spawnChild("")
    }
}

fn pollProcess(app: mutref<App>) -> Void {
    let resultData: MutSpan<u8> = app.result
    let packetData: MutSpan<u8> = app.packet
    let responseData: MutSpan<u8> = app.response
    let errorsData: MutSpan<u8> = app.errors
    var chunk: [4096]u8 = [0_u8; 4096]
    if app.sent < bufLen(packetData) {
        let written: Maybe<usize> = std.proc.writeStdin(app.child, std.mem.dropPrefix(bytes(packetData), app.sent))
        if written.has {
            app.sent = app.sent + written.value
            if app.sent == bufLen(packetData) {
                let closed: Bool = std.proc.closeStdin(app.child)
            }
        }
    }
    var drain: usize = 0
    while drain < 16 {
        let count: Maybe<usize> = std.proc.readStdout(app.child, chunk)
        if count.has {
            if count.value == 0 {
                break
            }
            if app.phase == 1 {
                append(responseData, std.mem.prefix(chunk, count.value))
            } else {
                append(resultData, std.mem.prefix(chunk, count.value))
            }
            drain = drain + 1
        } else {
            break
        }
    }
    let errorCount: Maybe<usize> = std.proc.readStderr(app.child, chunk)
    if errorCount.has {
        append(errorsData, std.mem.prefix(chunk, errorCount.value))
    }
    if !bufOk(responseData) || !bufOk(resultData) || !bufOk(errorsData) {
        if app.phase == 1 {
            failTurn(app, "Provider response exceeded the 96 KiB transport limit.")
        } else {
            stopChild(app)
            toolResult(app, "Error: command output exceeded 16 KiB. Re-run with a narrower query or redirect output.")
        }
        return
    }
    var seconds: i32 = 100
    if app.phase == 3 {
        seconds = 60
    }
    if std.time.hasElapsed(app.started, std.time.monotonic(), std.time.seconds(seconds)) {
        if app.phase == 1 {
            failTurn(app, "Provider timed out. Try again or choose another model.")
        } else {
            stopChild(app)
            toolResult(app, "Error: command was stopped after the 60-second timeout.")
        }
        return
    }
    if std.proc.running(app.child) {
        return
    }
    let status: ProcStatus = std.proc.wait(app.child)
    while true {
        let count: Maybe<usize> = std.proc.readStdout(app.child, chunk)
        if count.has {
            if count.value == 0 {
                break
            }
            if app.phase == 1 {
                append(responseData, std.mem.prefix(chunk, count.value))
            } else {
                append(resultData, std.mem.prefix(chunk, count.value))
            }
        } else {
            break
        }
    }
    while true {
        let count: Maybe<usize> = std.proc.readStderr(app.child, chunk)
        if count.has {
            if count.value == 0 {
                break
            }
            append(errorsData, std.mem.prefix(chunk, count.value))
        } else {
            break
        }
    }
    let closed: Bool = std.proc.close(app.child)
    app.child = std.proc.spawnChild("")
    if app.phase == 1 {
        if !bufOk(responseData) {
            failTurn(app, "Provider response exceeded the transport limit.")
            return
        }
        if std.proc.failed(status) {
            failTurn(app, "Native HTTP worker failed. Check the endpoint and runtime installation.")
            return
        }
        receiveResponse(app)
    } else {
        if !bufOk(resultData) || !bufOk(errorsData) {
            toolResult(app, "Error: command output exceeded the limit. Use a narrower query.")
            return
        }
        if bufLen(errorsData) > 0 {
            append(resultData, "\n[stderr]\n")
            append(resultData, bytes(errorsData))
        }
        var codeStorage: [32]u8 = [0_u8; 32]
        let code: Maybe<Span<u8>> = std.fmt.i32(codeStorage, std.proc.exitCode(status))
        if code.has {
            append(resultData, "\n[exit ")
            append(resultData, code.value)
            put(resultData, 93_u8)
        }
        toolResult(app, bytes(resultData))
    }
}

fn requestBody(app: mutref<App>) -> Void {
    let historyData: MutSpan<u8> = app.history
    let modelData: MutSpan<u8> = app.model
    let scratchData: MutSpan<u8> = app.scratch
    buildSystemContext(app)
    let system: MutSpan<u8> = app.systemContext
    clear(scratchData)
    append(scratchData, "{\"model\":")
    quoted(scratchData, bytes(modelData))
    if app.provider == 2 {
        append(scratchData, ",\"max_tokens\":4096,\"system\":")
        quoted(scratchData, bytes(system))
        append(scratchData, ",\"messages\":[")
    } else {
        if app.provider == 1 {
            append(scratchData, ",\"max_completion_tokens\":8192")
        } else {
            append(scratchData, ",\"max_tokens\":8192")
        }
        append(scratchData, ",\"messages\":[{\"role\":\"system\",\"content\":")
        quoted(scratchData, bytes(system))
        append(scratchData, "},")
    }
    append(scratchData, bytes(historyData))
    put(scratchData, 93_u8)
    if app.toolsEnabled {
        append(scratchData, ",\"tools\":")
        appendTools(scratchData, app.provider, app)
    }
    append(scratchData, ",\"stream\":false}")
}

fn startRequest(app: mutref<App>) -> Void {
    let historyData: MutSpan<u8> = app.history
    let keyData: MutSpan<u8> = app.key
    let endpointData: MutSpan<u8> = app.endpoint
    let workspaceData: MutSpan<u8> = app.workspace
    let executableData: MutSpan<u8> = app.executable
    let packetData: MutSpan<u8> = app.packet
    let responseData: MutSpan<u8> = app.response
    let errorsData: MutSpan<u8> = app.errors
    let scratchData: MutSpan<u8> = app.scratch
    if app.turn >= app.maxTurns {
        failTurn(app, "Reached the request limit for this turn. Start a new task to continue.")
        return
    }
    if bufLen(keyData) == 0 {
        failTurn(app, "No API key. Use /key or export the selected provider's API key variable.")
        return
    }
    if !headerSafe(bytes(keyData)) || !headerSafe(bytes(endpointData)) {
        failTurn(app, "The API key or endpoint contains invalid control characters.")
        return
    }
    if !std.str.startsWith(bytes(endpointData), "https://") && !std.str.startsWith(bytes(endpointData), "http://127.0.0.1:") && !std.str.startsWith(bytes(endpointData), "http://localhost:") {
        failTurn(app, "Endpoints must use HTTPS. Plain HTTP is supported only on localhost for testing.")
        return
    }
    requestBody(app)
    if !bufOk(scratchData) || !bufOk(historyData) || !bufOk(app.systemContext) {
        failTurn(app, "Conversation reached the 112 KiB context limit. Use /clear and give a shorter task.")
        return
    }
    var headerStorage: [4096]u8 = [0_u8; 4096]
    var targetStorage: [2304]u8 = [0_u8; 2304]
    var headers: MutSpan<u8> = buffer(headerStorage)
    var target: MutSpan<u8> = buffer(targetStorage)
    append(target, "POST ")
    append(target, bytes(endpointData))
    if app.provider == 2 {
        append(headers, "x-api-key: ")
        append(headers, bytes(keyData))
        append(headers, "\nanthropic-version: 2023-06-01")
    } else {
        append(headers, "Authorization: Bearer ")
        append(headers, bytes(keyData))
        if app.provider == 0 {
            append(headers, "\nHTTP-Referer: https://zerolang.ai\nX-Title: Zero Coding TUI")
        }
    }
    clear(packetData)
    let envelope: Maybe<Span<u8>> = std.http.writeJsonRequestWithHeaders(packetData, bytes(target), bytes(headers), bytes(scratchData))
    if !envelope.has {
        failTurn(app, "Request is too large for the transport buffer.")
        return
    }
    setLen(packetData, std.mem.len(envelope.value))
    clear(scratchData)
    append(scratchData, "--http-worker\n")
    number(scratchData, bufLen(packetData))
    app.child = std.proc.spawnChildArgs(bytes(executableData), bytes(scratchData), bytes(workspaceData), "")
    if !std.proc.childValid(app.child) {
        failTurn(app, "Unable to start the native HTTP worker.")
        return
    }
    if app.turn > 0 && !app.headless {
        logEntry(app, "  WAITING FOR MODEL", "Continuing after tool results…")
    }
    app.sent = 0
    app.phase = 1
    app.started = std.time.monotonic()
    app.turn = app.turn + 1
    clear(responseData)
    clear(app.result)
    clear(errorsData)
}

fn appendTools(output: MutSpan<u8>, provider: usize, app: ref<App>) -> Void {
    append(output, "[ ")
    var index: usize = 0
    var builtins: usize = 6
    if app.skillCount > 0 {
        builtins = 7
    }
    while index < builtins {
        if index > 0 {
            put(output, 44_u8)
        }
        if provider != 2 {
            append(output, "{\"type\":\"function\",\"function\":")
        }
        append(output, "{\"name\":")
        quoted(output, toolNameAt(index))
        append(output, ",\"description\":")
        quoted(output, toolDescription(index))
        if provider == 2 {
            append(output, ",\"input_schema\":")
        } else {
            append(output, ",\"parameters\":")
        }
        append(output, toolSchema(index))
        put(output, 125_u8)
        if provider != 2 {
            put(output, 125_u8)
        }
        index = index + 1
    }
    let registry: MutSpan<u8> = app.mcpTools
    index = 0
    while index < 128 {
        let tool: Span<u8> = arrayItem(bytes(registry), index)
        if std.mem.eql(tool, "null") {
            break
        }
        put(output, 44_u8)
        if provider != 2 {
            append(output, "{\"type\":\"function\",\"function\":")
        }
        append(output, "{\"name\":")
        append(output, field(tool, "name"))
        append(output, ",\"description\":")
        append(output, field(tool, "description"))
        if provider == 2 {
            append(output, ",\"input_schema\":")
        } else {
            append(output, ",\"parameters\":")
        }
        append(output, field(tool, "inputSchema"))
        put(output, 125_u8)
        if provider != 2 {
            put(output, 125_u8)
        }
        index = index + 1
    }
    put(output, 93_u8)
}

fn toolNameAt(index: usize) -> String {
    if index == 6 {
        return "load_skill"
    }
    if index == 0 {
        return "read_file"
    }
    if index == 1 {
        return "write_file"
    }
    if index == 2 {
        return "edit_file"
    }
    if index == 3 {
        return "list_files"
    }
    if index == 4 {
        return "run_command"
    }
    return "finish_task"
}

fn toolSchema(index: usize) -> String {
    if index == 6 {
        return "{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\",\"description\":\"Exact available skill name\"},\"path\":{\"type\":\"string\",\"description\":\"Optional resource path relative to the skill directory; defaults to SKILL.md\"}},\"required\":[\"name\"],\"additionalProperties\":false}"
    }
    if index == 5 {
        return "{\"type\":\"object\",\"properties\":{\"summary\":{\"type\":\"string\",\"description\":\"Concise final summary of confirmed work. This ends the task.\"}},\"required\":[\"summary\"],\"additionalProperties\":false}"
    }
    if index == 0 {
        return "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"Relative file path in the workspace\"}},\"required\":[\"path\"],\"additionalProperties\":false}"
    }
    if index == 1 {
        return "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"content\":{\"type\":\"string\",\"description\":\"Complete UTF-8 file contents, at most 12 KiB\"}},\"required\":[\"path\",\"content\"],\"additionalProperties\":false}"
    }
    if index == 2 {
        return "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"old_text\":{\"type\":\"string\",\"description\":\"Exact nonempty text to replace; must occur exactly once\"},\"new_text\":{\"type\":\"string\"}},\"required\":[\"path\",\"old_text\",\"new_text\"],\"additionalProperties\":false}"
    }
    if index == 3 {
        return "{\"type\":\"object\",\"properties\":{},\"additionalProperties\":false}"
    }
    return "{\"type\":\"object\",\"properties\":{\"command\":{\"type\":\"string\",\"description\":\"Shell command to run in the workspace after approval. No interactive commands.\"}},\"required\":[\"command\"],\"additionalProperties\":false}"
}

fn toolDescription(index: usize) -> String {
    if index == 6 {
        return "Load instructions or a text reference for an available skill. Respects .gitignore and rejects unsafe paths and symlinks. This does not execute bundled scripts or grant tool approvals."
    }
    if index == 0 {
        return "Read a UTF-8 workspace file up to 16 KiB. Inspect before editing. Files ignored by .gitignore, secret files and symlinks are rejected."
    }
    if index == 1 {
        return "Create or replace a file after user approval. Shows the proposed contents. Creates missing parent directories after approval."
    }
    if index == 2 {
        return "Replace one exact occurrence of old_text with new_text after user approval. Fails if old_text is missing or ambiguous."
    }
    if index == 3 {
        return "List workspace files using .gitignore rules, including nested rules and exceptions. Also excludes version control, dependency folders and secrets. Output is bounded."
    }
    if index == 5 {
        return "End the current task immediately with a concise summary of completed work and any verification. Call only after tool results confirm the requested work is done. Call this alone; no tools will run after it."
    }
    return "Run a shell command after user approval. Use for searches, builds, tests and Zero compiler graph operations. Has a 60-second timeout."
}

fn nextTool(app: mutref<App>) -> Void {
    if !app.toolsEnabled {
        failTurn(app, "Provider returned a tool call while tools were disabled.")
        return
    }
    let pendingData: MutSpan<u8> = app.pending
    let argumentsData: MutSpan<u8> = app.arguments
    let toolIdData: MutSpan<u8> = app.toolId
    let toolNameData: MutSpan<u8> = app.toolName
    let scratchData: MutSpan<u8> = app.scratch
    let call: Span<u8> = arrayItem(bytes(pendingData), app.toolIndex)
    if std.mem.eql(call, "null") {
        startRequest(app)
        return
    }
    if app.toolIndex >= 64 {
        failTurn(app, "Provider returned too many tool calls in one response.")
        return
    }
    let idOk: Bool = decode(toolIdData, field(call, "id"))
    var nameOk: Bool = false
    var argsOk: Bool = false
    if app.provider == 2 {
        nameOk = decode(toolNameData, field(call, "name"))
        setText(argumentsData, field(call, "input"))
        argsOk = bufOk(argumentsData)
    } else {
        let function: Span<u8> = field(call, "function")
        nameOk = decode(toolNameData, field(function, "name"))
        argsOk = decode(argumentsData, field(function, "arguments"))
    }
    if !idOk || bufLen(toolIdData) == 0 {
        failTurn(app, "Provider returned a tool call without a valid ID.")
        return
    }
    if !nameOk || !argsOk || !std.json.validateBytes(bytes(argumentsData)) {
        toolResult(app, "Error: tool name or arguments are invalid or too large.")
        return
    }
    if std.mem.eql(bytes(toolNameData), "finish_task") {
        finishTask(app)
        return
    }
    logEntry(app, "  TOOL", bytes(toolNameData))
    if std.mem.eql(bytes(toolNameData), "load_skill") {
        loadSkillTool(app)
        return
    }
    if std.mem.eql(bytes(toolNameData), "read_file") {
        readTool(app)
        return
    }
    if std.mem.eql(bytes(toolNameData), "list_files") {
        clear(scratchData)
        append(scratchData, gitIgnoreSetup())
        append(scratchData, "git ls-files --others --exclude-standard -z --exclude='.git/' --exclude='node_modules/' --exclude='.tools/' --exclude='.zero/' --exclude='.venv/' --exclude='.ssh/' --exclude='.zero-agent/' --exclude='.env' --exclude='.env.*' --exclude='*.pem' --exclude='*.key' > \"$zero_ignore_tmp/files\" || exit 1; xargs -0 /bin/sh -c 'for p do if [ -f \"$p\" ] && [ ! -L \"$p\" ]; then printf \"./%s\\n\" \"$p\"; fi; done' zero-list < \"$zero_ignore_tmp/files\" | head -200")
        launchCommand(app, bytes(scratchData))
        return
    }
    if std.mem.eql(bytes(toolNameData), "run_command") {
        if !decode(scratchData, field(bytes(argumentsData), "command")) || bufLen(scratchData) == 0 {
            toolResult(app, "Error: command must be a nonempty string.")
            return
        }
        logEntry(app, "  $  PROPOSED COMMAND", bytes(scratchData))
    } else if !std.mem.eql(mcpTool(app, bytes(toolNameData)), "null") {
        logEntry(app, "  MCP TOOL · APPROVAL REQUIRED", bytes(toolNameData))
        logEntry(app, "  ARGUMENTS", bytes(argumentsData))
    } else if std.mem.eql(bytes(toolNameData), "write_file") || std.mem.eql(bytes(toolNameData), "edit_file") {
        if !prepareFile(app) {
            return
        }
    } else {
        toolResult(app, "Error: unknown tool name.")
        return
    }
    if app.approve {
        approveTool(app)
        return
    }
    if app.headless {
        toolResult(app, "Error: action denied. Noninteractive runs require --approve for edits, commands and MCP calls.")
        return
    }
    app.phase = 4
    app.view = 4
}

fn approveTool(app: mutref<App>) -> Void {
    let argumentsData: MutSpan<u8> = app.arguments
    let toolNameData: MutSpan<u8> = app.toolName
    let scratchData: MutSpan<u8> = app.scratch
    if std.str.startsWith(bytes(toolNameData), "mcp__") {
        callMcpTool(app)
        return
    }
    if std.mem.eql(bytes(toolNameData), "run_command") {
        let valid: Bool = decode(scratchData, field(bytes(argumentsData), "command"))
        if !valid || bufLen(scratchData) == 0 {
            toolResult(app, "Error: command must be a nonempty string.")
            return
        }
        if containsNul(bytes(scratchData)) {
            toolResult(app, "Error: command contains a NUL byte.")
            return
        }
        launchCommand(app, bytes(scratchData))
    } else {
        applyFile(app)
    }
}

fn submit(app: mutref<App>) -> Void {
    let historyData: MutSpan<u8> = app.history
    let transcriptData: MutSpan<u8> = app.transcript
    let inputData: MutSpan<u8> = app.input
    let modelData: MutSpan<u8> = app.model
    let keyData: MutSpan<u8> = app.key
    let endpointData: MutSpan<u8> = app.endpoint
    let workspaceData: MutSpan<u8> = app.workspace
    let scratchData: MutSpan<u8> = app.scratch
    if app.phase != 0 {
        return
    }
    let input: Span<u8> = std.str.trimAscii(bytes(inputData))
    if app.view == 3 {
        if std.mem.len(input) == 0 || !headerSafe(input) {
            return
        }
        let erased: usize = std.mem.fill(keyData, 0_u8)
        setText(keyData, input)
        if !bufOk(keyData) {
            clear(keyData)
            logEntry(app, "  !", "API key is too long.")
        } else {
            logEntry(app, "  CONNECTED", "API key set for this session. Send a task to connect to the provider.")
        }
        eraseInput(app)
        app.view = 0
        return
    }
    if app.view == 2 {
        if std.mem.len(input) == 0 || std.mem.len(input) > 200 || !headerSafe(input) {
            return
        }
        setText(modelData, input)
        clear(historyData)
        logEntry(app, "  MODEL", bytes(modelData))
        eraseInput(app)
        app.view = 0
        return
    }
    if app.view != 0 || std.mem.len(input) == 0 {
        return
    }
    if std.mem.eql(input, "/mcp") || std.str.startsWith(input, "/mcp ") {
        mcpCommand(app, input)
        eraseInput(app)
        return
    }
    if std.mem.eql(input, "/skills") || std.mem.eql(input, "/skills reload") {
        if std.mem.eql(input, "/skills reload") {
            reloadSkills(app)
        }
        showSkills(app)
        eraseInput(app)
        return
    }
    if std.str.startsWith(input, "/skill ") {
        selectSkill(app, std.str.trimAscii(std.mem.dropPrefix(input, 7_usize)))
        eraseInput(app)
        return
    }
    if std.mem.eql(input, "/quit") || std.mem.eql(input, "/exit") {
        app.alive = false
        return
    }
    if std.mem.eql(input, "/help") {
        openDialog(app, 5_usize)
        return
    }
    if std.mem.eql(input, "/provider") {
        openDialog(app, 1_usize)
        return
    }
    if std.mem.eql(input, "/model") {
        openDialog(app, 2_usize)
        return
    }
    if std.mem.eql(input, "/key") {
        openDialog(app, 3_usize)
        return
    }
    if std.mem.eql(input, "/clear") {
        clear(historyData)
        clear(transcriptData)
        eraseInput(app)
        return
    }
    if std.str.startsWith(input, "/model ") {
        let id: Span<u8> = std.str.trimAscii(std.mem.dropPrefix(input, 7_usize))
        if std.mem.len(id) > 0 && std.mem.len(id) < 201 && headerSafe(id) {
            setText(modelData, id)
            clear(historyData)
            logEntry(app, "  MODEL", bytes(modelData))
        }
        eraseInput(app)
        return
    }
    if std.mem.eql(input, "/tools off") || std.mem.eql(input, "/tools on") {
        app.toolsEnabled = std.mem.eql(input, "/tools on")
        clear(historyData)
        if app.toolsEnabled {
            logEntry(app, "  AGENT MODE", "Tools enabled. Conversation reset.")
        } else {
            logEntry(app, "  CHAT MODE", "Chat mode: tools disabled. Any text model can be used. Conversation reset.")
        }
        eraseInput(app)
        return
    }
    if std.mem.eql(input, "/status") {
        clear(scratchData)
        append(scratchData, providerName(app.provider))
        append(scratchData, " / ")
        append(scratchData, bytes(modelData))
        append(scratchData, "\nWorkspace: ")
        append(scratchData, bytes(workspaceData))
        append(scratchData, "\nEndpoint: ")
        append(scratchData, bytes(endpointData))
        logEntry(app, "  SESSION", bytes(scratchData))
        eraseInput(app)
        return
    }
    if input[0] == 47 {
        logEntry(app, "  !", "Unknown command. Use /help.")
        eraseInput(app)
        return
    }
    if app.demo {
        logEntry(app, "  DEMO", "This is a simulated session. Restart without --demo to use your provider.")
        eraseInput(app)
        return
    }
    if bufLen(keyData) == 0 {
        logEntry(app, "  !", "Use /key to connect, then send your task.")
        return
    }
    app.turnStart = bufLen(historyData)
    app.turn = 0
    app.repeatCount = 0
    clear(app.lastToolSnapshot)
    app.exitCode = 0
    userMessage(app, input)
    logEntry(app, "  YOU", input)
    eraseInput(app)
    startRequest(app)
}

fn render(world: World, app: mutref<App>) -> Void raises {
    let transcriptData: MutSpan<u8> = app.transcript
    let modelData: MutSpan<u8> = app.model
    let keyData: MutSpan<u8> = app.key
    let frameData: MutSpan<u8> = app.frame
    var columns: usize = std.term.widthOr(100_usize)
    var rows: usize = std.term.heightOr(32_usize)
    if columns > 220 {
        columns = 220
    }
    if rows > 70 {
        rows = 70
    }
    clear(frameData)
    append(frameData, "\x1b[0m\x1b[48;5;234m\x1b[38;5;252m\x1b[2J\x1b[H")
    if columns < 72 || rows < 24 {
        append(frameData, "\n  ZERO · Expand your terminal to at least 72 × 24.\n\n  Ctrl-C to exit.")
        check world.out.write(bytes(frameData))
        return
    }
    paint(app, 2_usize, 4_usize, "\x1b[1;38;5;183m", "◇ ZERO")
    paint(app, 2_usize, 13_usize, "\x1b[22;38;5;244m", "/ coding agent")
    paint(app, 2_usize, columns - 21, "\x1b[38;5;244m", "NATIVE ZERO   v0.1")
    rule(app, 3_usize, columns)
    if app.view == 1 {
        renderPicker(app, rows, columns)
    } else if app.view == 2 || app.view == 3 {
        if app.view == 2 {
            paint(app, 6_usize, 7_usize, "\x1b[1;38;5;255m", "Use the model you want")
            paint(app, 9_usize, 7_usize, "\x1b[22;38;5;245m", "Enter any model ID. Use /tools off for chat-only models.")
            paint(app, 12_usize, 7_usize, "\x1b[38;5;183m", defaultModel(app.provider))
        } else {
            paint(app, 6_usize, 7_usize, "\x1b[1;38;5;255m", "Connect your provider")
            paint(app, 9_usize, 7_usize, "\x1b[22;38;5;245m", "Your key stays in memory and is never saved to disk.")
            paint(app, 12_usize, 7_usize, "\x1b[38;5;183m", keyVariable(app.provider))
            paint(app, 14_usize, 7_usize, "\x1b[38;5;245m", "Export this variable, or paste the key below.")
        }
        paint(app, rows - 8, 7_usize, "\x1b[38;5;245m", "enter save     esc cancel")
    } else if app.view == 5 {
        paint(app, 5_usize, 7_usize, "\x1b[1;38;5;255m", "A little help")
        paint(app, 8_usize, 7_usize, "\x1b[22;38;5;183m", "/provider     Choose a provider  ·  Ctrl-P")
        paint(app, 9_usize, 7_usize, "\x1b[38;5;250m", "/model ID     Choose any compatible model")
        paint(app, 10_usize, 7_usize, "\x1b[38;5;250m", "/key          Enter a key without saving it")
        paint(app, 11_usize, 7_usize, "\x1b[38;5;250m", "/tools on|off Enable tools or use a chat-only model")
        paint(app, 12_usize, 7_usize, "\x1b[38;5;250m", "/clear        Start a fresh conversation  ·  Ctrl-L")
        paint(app, 13_usize, 7_usize, "\x1b[38;5;250m", "/status       Show connection and workspace details")
        paint(app, 14_usize, 7_usize, "\x1b[38;5;250m", "/quit         Exit  ·  Ctrl-D")
        paint(app, 15_usize, 7_usize, "\x1b[38;5;250m", "/mcp          Connect and manage MCP tool servers")
        paint(app, 16_usize, 7_usize, "\x1b[38;5;250m", "/skills       List skills  ·  /skill NAME selects one")
        paint(app, 17_usize, 7_usize, "\x1b[38;5;245m", "Esc cancels work. PgUp/PgDn scroll. Paste is supported.")
    } else if bufLen(transcriptData) == 0 {
        renderWelcome(app, rows, columns)
    } else {
        renderTranscript(app, rows, columns)
    }
    rule(app, rows - 6, columns)
    if app.phase == 4 {
        paint(app, rows - 5, 4_usize, "\x1b[1;38;5;222m", "Approve this action?")
        paint(app, rows - 3, 4_usize, "\x1b[22;38;5;252m", "[y] approve once   [n] deny   [PgUp/PgDn] review")
    } else {
        renderInput(app, rows - 4, columns)
        var status: String = "ready"
        var color: String = "\x1b[38;5;114m"
        if bufLen(keyData) == 0 {
            status = "key required"
            color = "\x1b[38;5;222m"
        }
        if app.phase == 1 {
            status = "waiting for model"
            color = "\x1b[38;5;183m"
        }
        if app.phase == 2 {
            status = "using tools"
            color = "\x1b[38;5;183m"
        }
        if app.phase == 3 {
            status = "running command · esc to stop"
            color = "\x1b[38;5;183m"
        }
        if app.phase == 5 {
            status = "MCP request · esc to stop"
            color = "\x1b[38;5;183m"
        }
        if app.demo {
            status = "demo · simulated session"
            color = "\x1b[38;5;222m"
        }
        paint(app, rows - 2, 4_usize, color, "● ")
        append(frameData, status)
        if app.phase == 1 || app.phase == 3 || app.phase == 5 {
            append(frameData, " · ")
            number(frameData, std.time.asSecondsFloor(std.time.between(app.started, std.time.monotonic())) as usize)
            append(frameData, "s")
        }
        paint(app, rows - 2, columns - 29, "\x1b[38;5;244m", "enter send  /help  ctrl-p")
    }
    rule(app, rows - 1, columns)
    paint(app, rows, 4_usize, "\x1b[38;5;183m", providerName(app.provider))
    append(frameData, "\x1b[38;5;244m  /  ")
    let model: Span<u8> = bytes(modelData)
    append(frameData, slice(model, 0_usize, lineEnd(model, 0_usize, columns - 49)))
    position(frameData, rows, columns - 28)
    append(frameData, "\x1b[38;5;244m")
    number(frameData, app.toolCount)
    append(frameData, " tools · ")
    number(frameData, app.tokens)
    append(frameData, " tokens")
    append(frameData, "\x1b[0m\x1b[?25l")
    if bufOk(frameData) {
        check world.out.write(bytes(frameData))
    }
}

fn helpText() -> String {
    return "Zero Coding TUI 0.1.0 — written in Zero\n\nUsage: zero-coding [options]\n\n  --provider NAME   openrouter, openai, claude, gemini\n  --model ID        Any exact model ID from that provider\n  --cwd PATH        Workspace directory (default: current directory)\n  --endpoint URL    Override the complete provider API endpoint\n  --prompt TEXT     Run one task without a TUI; writes are denied by default\n  --chat-only       Chat without tools (for models without tool support)\n  --approve         Allow all model-requested writes, shell commands and MCP calls\n  --max-turns N     Maximum model requests per task (1–50, default 20)\n  --mcp NAME|all    Connect configured MCP stdio servers at startup\n  --mcp-config PATH MCP JSON configuration (default: .mcp.json)\n  --skills-dir PATH Additional skill collection directory\n  --skill NAME      Select a skill for this session\n  --no-skills       Disable skill discovery\n  --demo            Preview a simulated session, without keys or changes\n  --snapshot        Render one terminal frame and exit\n  --self-test       Run native core tests without network access\n  --help            Show this help\n  --version         Show the application version\n\nAPI keys: OPENROUTER_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY,\n          GEMINI_API_KEY (or GOOGLE_API_KEY), or enter one with /key.\nKeys are held in memory and never stored in the project.\n\nTUI: /provider /model /key /clear /status /tools on|off /help /quit\n     /mcp /skills /skill NAME|off\n     Ctrl-P provider picker, Esc cancel, PgUp/PgDn scroll.\n\nFile tools are confined to relative, non-symlink workspace paths.\nApproved shell commands run as your user and are not sandboxed.\n"
}
