fn execute(world: World) -> i32 raises {
    if hasArg("--http-worker") {
        let group: Maybe<String> = std.args.valueAfter("--worker-group")
        if group.has {
            let parent: Maybe<u32> = std.parse.parseU32(group.value)
            if !parent.has {
                return 1
            }
            if process.zero_join_worker_group(parent.value) == 0 {
                return 1
            }
        }
        httpWorker(world)
        return 0
    }
    if hasArg("--help") || hasArg("-h") {
        check world.out.write(helpText())
        return 0
    }
    if hasArg("--version") {
        check world.out.write("zero-code 0.1.0 (native Zero)\n")
        return 0
    }
    if hasArg("--self-test") {
        check nativeTests(world)
        return 0
    }
    if process.zero_prepare_stack() == 0 {
        check world.out.write("Unable to reserve the application's 64 MiB stack for file tools.\n")
        return 1
    }
    return runApplication(world)
}

pub fn main(world: World) -> Void {
    let code: i32 = rescue execute(world) err 1
    process.exit(code)
}

fn submit(app: mutref<App>) -> Void {
    let input: Span<u8> = std.str.trimAscii(bytes(app.input))
    var control: Bool = false
    if app.phase == 0 && app.view == 0 && std.mem.len(input) > 0 && !app.demo {
        control = input[0] == 47
        learningStart(app, input)
    }
    submitInput(app)
    if app.learningActive && app.phase == 0 {
        if control {
            learningFinish(app, "control", "Local command finished; inspect trajectory for its result.")
        } else {
            learningFinish(app, "failed", "The task did not start.")
        }
    }
}
