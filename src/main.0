    endpoint: MutSpan<u8>,
    workspace: MutSpan<u8>,
    executable: MutSpan<u8>,
    pending: MutSpan<u8>,
    arguments: MutSpan<u8>,
    toolId: MutSpan<u8>,
    toolName: MutSpan<u8>,
    result: MutSpan<u8>,
    packet: MutSpan<u8>,
    response: MutSpan<u8>,
    errors: MutSpan<u8>,
    scratch: MutSpan<u8>,
    frame: MutSpan<u8>,
    keyboard: MutSpan<u8>,
    child: ProcChild,
    sent: usize,
    toolIndex: usize,
    turn: usize,
    maxTurns: usize,
    toolCount: usize,
    filesChanged: usize,
    tokens: usize,
    scroll: usize,
    turnStart: usize,
    started: Duration,
    tick: usize,
