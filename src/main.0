fn execute(world: World) -> i32 raises {
    if hasArg("--http-worker") {
        let group: Maybe<String> = std.args.valueAfter("--worker-group")
        if group.has {
            let parent: Maybe<u32> = std.parse.parseU32(group.value)
            if !parent.has { return 1 }
            if process.zero_join_worker_group(parent.value) == 0 { return 1 }
        }
        httpWorker(world)
        return 0
    }
    if hasArg("--help") || hasArg("-h") {
        check world.out.write(helpText())
        return 0
    }
    if hasArg("--version") {
        check world.out.write("zero-coding 0.1.0 (native Zero)\n")
        return 0
    }
    if hasArg("--self-test") {
        check nativeTests(world)
        return 0
    }
    return runApplication(world)
}

pub fn main(world: World) -> Void {
    let code: i32 = rescue execute(world) err 1
    process.exit(code)
}
