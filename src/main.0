fn displayStorage(world: World, app: mutref<App>) -> i32 {
    var transcript: [65536]u8 = [0_u8; 65536]
    let previoustranscript: MutSpan<u8> = app.transcript
    app.transcript = buffer(transcript)
    var pending: [12845072]u8 = [0_u8; 12845072]
    let previouspending: MutSpan<u8> = app.pending
    app.pending = buffer(pending)
    let code: i32 = packetStorage(world, app)
    app.pending = previouspending
    app.transcript = previoustranscript
    return code
}

fn historyStorage(world: World, app: mutref<App>) -> i32 {
    var history: [6291472]u8 = [0_u8; 6291472]
    let previoushistory: MutSpan<u8> = app.history
    app.history = buffer(history)
    let code: i32 = displayStorage(world, app)
    app.history = previoushistory
    return code
}

fn toolGuardStorage(world: World, app: mutref<App>) -> i32 {
    var snapshotStorage: [33024]u8 = [0_u8; 33024]
    let previouslastToolSnapshot: MutSpan<u8> = app.lastToolSnapshot
    app.lastToolSnapshot = buffer(snapshotStorage)
    let code: i32 = historyStorage(world, app)
    app.lastToolSnapshot = previouslastToolSnapshot
    return code
}

fn frameStorage(world: World, app: mutref<App>) -> i32 {
    var previous: [49152]u8 = [0_u8; 49152]
    var index: [1024]u8 = [0_u8; 1024]
    var previousIndex: [1024]u8 = [0_u8; 1024]
    let savedFrame: MutSpan<u8> = app.previousFrame
    let savedIndex: MutSpan<u8> = app.frameIndex
    let savedPreviousIndex: MutSpan<u8> = app.previousFrameIndex
    app.previousFrame = buffer(previous)
    app.frameIndex = buffer(index)
    app.previousFrameIndex = buffer(previousIndex)
    let code: i32 = toolGuardStorage(world, app)
    app.previousFrame = savedFrame
    app.frameIndex = savedIndex
    app.previousFrameIndex = savedPreviousIndex
    return code
}

