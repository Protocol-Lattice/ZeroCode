    var app: App = App { provider: 0, view: 0, selection: 0, phase: 0, alive: true, headless: false, approve: false, demo: false, paste: false, history: buffer(historyEmpty), transcript: buffer(transcriptEmpty), input: buffer(input), model: buffer(model), key: buffer(key), endpoint: buffer(endpoint), workspace: buffer(workspace), executable: buffer(executable), pending: buffer(pendingEmpty), arguments: buffer(arguments), toolId: buffer(toolId), toolName: buffer(toolName), result: buffer(result), packet: buffer(packetEmpty), response: buffer(responseEmpty), errors: buffer(errors), scratch: buffer(scratchEmpty), frame: buffer(frame), keyboard: buffer(keyboard), previousFrame: buffer(responseEmpty), frameIndex: buffer(responseEmpty), previousFrameIndex: buffer(responseEmpty), frameRows: 0, frameColumns: 0, child: std.proc.spawnChild(""), sent: 0, toolIndex: 0, turn: 0, maxTurns: 20, toolCount: 0, commandResult: false, commandExitCode: 0, commandOutputBytes: 0, commandElapsedMs: 0, filesChanged: 0, tokens: 0, scroll: 0, turnStart: 0, started: std.time.monotonic(), tick: 0, exitCode: 0, toolsEnabled: true, lastToolSnapshot: buffer(snapshotEmpty), repeatCount: 0, mcpConfig: buffer(mcpConfigEmpty), mcpTools: buffer(mcpToolsEmpty), mcpTx: buffer(mcpTxEmpty), mcpCursor: buffer(mcpCursorEmpty), skills: buffer(skillsEmpty), activeSkill: buffer(activeSkillEmpty), systemContext: buffer(systemContextEmpty), memory: buffer(responseEmpty), memoryEnabled: true, memorySkipSave: false, logEnabled: false, logFailed: false, logStreaming: false, logSequence: 0, logPath: buffer(responseEmpty), logSecrets: buffer(responseEmpty), logTail: buffer(responseEmpty), logWorkerTail0: buffer(responseEmpty), logWorkerTail1: buffer(responseEmpty), logWorkerTail2: buffer(responseEmpty), logWorkerTail3: buffer(responseEmpty), mcpRx0: buffer(mcpRx0Empty), mcpRx1: buffer(mcpRx1Empty), mcpRx2: buffer(mcpRx2Empty), mcpRx3: buffer(mcpRx3Empty), mcpChild0: std.proc.spawnChild(""), mcpChild1: std.proc.spawnCh