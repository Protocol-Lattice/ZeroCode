    mcpRx1: MutSpan<u8>,
    mcpRx2: MutSpan<u8>,
    mcpRx3: MutSpan<u8>,
    mcpChild0: ProcChild,
    mcpChild1: ProcChild,
    mcpChild2: ProcChild,
    mcpChild3: ProcChild,
    mcpCount: usize,
    mcpIndex: usize,
