fn capacity(value: MutSpan<u8>) -> usize {
    if std.mem.len(value) < 16 {
        return 0
    }
    return std.mem.len(value) - 16
}

fn bufLen(value: MutSpan<u8>) -> usize {
    let at: usize = capacity(value)
    if std.mem.len(value) < 16 {
        return 0
    }
    return value[at] as usize + value[at + 1] as usize * 256 + value[at + 2] as usize * 65536
}

fn bufOk(value: MutSpan<u8>) -> Bool {
    if std.mem.len(value) < 16 {
        return false
    }
    return value[capacity(value) + 3] == 1
}

fn setOk(value: MutSpan<u8>, ok: Bool) -> Void {
    if std.mem.len(value) < 16 {
        return
    }
    if ok {
        value[capacity(value) + 3] = 1_u8
    } else {
        value[capacity(value) + 3] = 0_u8
    }
}

fn bytes(value: MutSpan<u8>) -> Span<u8> {
    return std.mem.prefix(value, bufLen(value))
}

fn clear(value: MutSpan<u8>) -> Void {
    setLen(value, 0)
    setOk(value, true)
}

fn append(value: MutSpan<u8>, text: Span<u8>) -> Void {
    if !bufOk(value) {
        return
    }
    let count: usize = std.mem.len(text)
    let length: usize = bufLen(value)
    if count > capacity(value) - length {
        setOk(value, false)
        return
    }
    let copied: usize = std.mem.copy(value[length..length + count], text)
    setLen(value, length + copied)
    if copied != count {
        setOk(value, false)
    }
}

fn put(value: MutSpan<u8>, byte: u8) -> Void {
    if !bufOk(value) {
        return
    }
    if bufLen(value) == capacity(value) {
        setOk(value, false)
        return
    }
    value[bufLen(value)] = byte
    setLen(value, bufLen(value) + 1)
}

fn setText(value: MutSpan<u8>, text: Span<u8>) -> Void {
    clear(value)
    append(value, text)
}

fn number(value: MutSpan<u8>, count: usize) -> Void {
    var storage: [32]u8 = [0_u8; 32]
    let text: Maybe<Span<u8>> = std.fmt.usize(storage, count)
    if text.has {
        append(value, text.value)
    }
}

fn slice(value: Span<u8>, start: usize, end: usize) -> Span<u8> {
    if start > end || end > std.mem.len(value) {
        return ""
    }
    return std.mem.prefix(std.mem.dropPrefix(value, start), end - start)
}

fn quoted(value: MutSpan<u8>, text: Span<u8>) -> Void {
    put(value, 34_u8)
    var i: usize = 0
    var start: usize = 0
    let hex: Span<u8> = "0123456789abcdef"
    while i < std.mem.len(text) {
        let c: u8 = text[i]
        if c == 34 || c == 92 {
            append(value, slice(text, start, i))
            put(value, 92_u8)
            put(value, c)
            start = i + 1
        } else if c < 32 {
            append(value, slice(text, start, i))
            append(value, "\\u00")
            put(value, hex[(c / 16) as usize])
            put(value, hex[(c % 16) as usize])
            start = i + 1
        }
        i = i + 1
    }
    append(value, std.mem.dropPrefix(text, start))
    put(value, 34_u8)
}

fn field(object: Span<u8>, name: Span<u8>) -> Span<u8> {
    let item: Maybe<Span<u8>> = std.json.field(object, name)
    if item.has {
        return item.value
    }
    return "null"
}

fn arrayItem(array: Span<u8>, wanted: usize) -> Span<u8> {
    let text: Span<u8> = std.str.trimAscii(array)
    if std.mem.len(text) < 2 || text[0] != 91 {
        return "null"
    }
    var i: usize = 1
    var start: usize = 1
    var item: usize = 0
    var depth: usize = 0
    var string: Bool = false
    var escaped: Bool = false
    while i < std.mem.len(text) {
        let c: u8 = text[i]
        if string {
            if escaped {
                escaped = false
            } else if c == 92 {
                escaped = true
            } else if c == 34 {
                string = false
            }
        } else if c == 34 {
            string = true
        } else if c == 123 || c == 91 {
            depth = depth + 1
        } else if (c == 44 || c == 93) && depth == 0 {
            if item == wanted {
                let value: Span<u8> = std.str.trimAscii(slice(text, start, i))
                if std.mem.len(value) == 0 {
                    return "null"
                }
                return value
            }
            if c == 93 {
                return "null"
            }
            item = item + 1
            start = i + 1
        } else if c == 125 || c == 93 {
            if depth > 0 {
                depth = depth - 1
            }
        }
        i = i + 1
    }
    return "null"
}

fn cleanText(output: MutSpan<u8>, text: Span<u8>) -> Void {
    var i: usize = 0
    while i < std.mem.len(text) {
        let c: u8 = text[i]
        if c == 10 {
            put(output, c)
        } else if c == 9 {
            append(output, "  ")
        } else if c >= 32 && c != 127 {
            if c < 128 {
                put(output, c)
            } else {
                let width: Maybe<usize> = std.unicode.widthAt(text, i)
                let cp: Maybe<u32> = std.unicode.decodeAt(text, i)
                if width.has && cp.has {
                    if cp.value >= 160 {
                        append(output, slice(text, i, i + width.value))
                    }
                    i = i + width.value - 1
                } else {
                    put(output, 63_u8)
                }
            }
        }
        i = i + 1
    }
}

fn headerSafe(text: Span<u8>) -> Bool {
    var i: usize = 0
    while i < std.mem.len(text) {
        if text[i] < 32 || text[i] == 127 {
            return false
        }
        i = i + 1
    }
    return true
}

fn pathsOk(left: i32, right: i32) -> i32 {
    if safeRelative("src/main.0") && !safeRelative("src/../outside") && !safeRelative("/etc/passwd") && !safeRelative(".env.local") && !safeRelative("src/.git/config") && !safeRelative("a\nb") {
        return 1
    }
    return 0
}

fn buffer(storage: MutSpan<u8>) -> MutSpan<u8> {
    setLen(storage, 0_usize)
    setOk(storage, true)
    return storage
}

fn setLen(value: MutSpan<u8>, length: usize) -> Void {
    let at: usize = capacity(value)
    if std.mem.len(value) < 16 {
        return
    }
    if length > at {
        value[at] = 0_u8
        value[at + 1] = 0_u8
        value[at + 2] = 0_u8
        setOk(value, false)
        return
    }
    value[at] = (length % 256) as u8
    value[at + 1] = (length / 256 % 256) as u8
    value[at + 2] = (length / 65536 % 256) as u8
}

fn containsNul(text: Span<u8>) -> Bool {
    var index: usize = 0
    while index < std.mem.len(text) {
        if text[index] == 0 {
            return true
        }
        index = index + 1
    }
    return false
}

fn decode(output: MutSpan<u8>, raw: Span<u8>) -> Bool {
    clear(output)
    let text: Maybe<Span<u8>> = std.json.stringDecode(output[..capacity(output)], raw)
    if text.has {
        setLen(output, std.mem.len(text.value))
        return bufOk(output)
    }
    return false
}

fn readBounded(output: MutSpan<u8>, path: String) -> Bool {
    clear(output)
    let count: Maybe<usize> = std.fs.readBytes(path, output[..capacity(output)])
    if !count.has {
        return false
    }
    if count.value > capacity(output) {
        setOk(output, false)
        return false
    }
    setLen(output, count.value)
    return bufOk(output)
}

fn compactJson(output: MutSpan<u8>, text: Span<u8>) -> Void {
    var inString: Bool = false
    var escaped: Bool = false
    var i: usize = 0
    while i < std.mem.len(text) {
        let c: u8 = text[i]
        if inString || c > 32 {
            put(output, c)
        }
        if c == 34 && !escaped {
            inString = !inString
        }
        if c == 92 && !escaped {
            escaped = true
        } else {
            escaped = false
        }
        i = i + 1
    }
}

fn quotedSize(text: Span<u8>) -> usize {
    var size: usize = 2
    var i: usize = 0
    while i < std.mem.len(text) {
        if text[i] < 32 {
            size = size + 6
        } else if text[i] == 34 || text[i] == 92 {
            size = size + 2
        } else {
            size = size + 1
        }
        i = i + 1
    }
    return size
}

fn utf8Prefix(text: Span<u8>, limit: usize) -> Span<u8> {
    if std.mem.len(text) <= limit {
        return text
    }
    var end: usize = limit
    while end > 0 && text[end] >= 128 && text[end] < 192 {
        end = end - 1
    }
    return std.mem.prefix(text, end)
}

fn inspectSelfGraph(app: mutref<App>) -> Void {
    if !learningProgramEnabled() || app.workerMode > 0 {
        toolResult(app, "Error: self_inspect requires launching this peer with --self-evolve.")
        return
    }
    if bufLen(app.arguments) > 4000 {
        toolResult(app, "Error: graph inspection arguments are too large.")
        return
    }
    let root: Span<u8> = std.env.getOr("ZERO_LEARNING_PROGRAM_ROOT", "")
    if !headerSafe(root) {
        toolResult(app, "Error: invalid program root.")
        return
    }
    var requestStorage: [8192]u8 = [0_u8; 8192]
    let request: MutSpan<u8> = buffer(requestStorage)
    append(request, "{\"version\":")
    quoted(request, learningProgramVersion())
    append(request, ",\"arguments\":")
    append(request, bytes(app.arguments))
    put(request, 125_u8)
    clear(app.packet)
    compactJson(app.packet, bytes(request))
    clear(app.scratch)
    append(app.scratch, root)
    append(app.scratch, "/scripts/learning_program.py\n--root\n")
    append(app.scratch, root)
    append(app.scratch, "\n--inspect\n")
    append(app.scratch, bytes(app.packet))
    if !bufOk(request) || !bufOk(app.packet) || !bufOk(app.scratch) {
        toolResult(app, "Error: graph inspection request is too large.")
        return
    }
    app.child = std.proc.spawnChildArgs("python3", bytes(app.scratch), bytes(app.workspace), "")
    if !std.proc.childValid(app.child) {
        toolResult(app, "Error: could not start the graph inspection driver.")
        return
    }
    let closed: Bool = std.proc.closeStdin(app.child)
    clear(app.packet)
    clear(app.result)
    clear(app.errors)
    app.sent = 0
    app.phase = 3
    app.view = 0
    app.started = std.time.monotonic()
}
