fn jobChild(app: ref<App>, index: usize) -> ProcChild {
    if index == 0 {
        return app.jobChild0
    }
    if index == 1 {
        return app.jobChild1
    }
    if index == 2 {
        return app.jobChild2
    }
    return app.jobChild3
}

fn setJobChild(app: mutref<App>, index: usize, value: ProcChild) -> Void {
    if index == 0 {
        app.jobChild0 = value
        return
    }
    if index == 1 {
        app.jobChild1 = value
        return
    }
    if index == 2 {
        app.jobChild2 = value
        return
    }
    app.jobChild3 = value
}

